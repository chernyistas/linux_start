<!DOCTYPE html>
<html>
<head>
    <title>{{ app_name }}</title>
</head>
<body>
    <h1>Hello from {{ app_name }}!</h1>
    <p>Hostname: {{ ansible_hostname }}</p>
    <p>OS: {{ ansible_distribution }} {{ ansible_distribution_version }}</p>
    <p>IP: {{ ansible_default_ipv4.address }}</p>
    <p>Port: {{ app_port }}</p>
</body>
</html>
