# ============================================================
# Конфиг Prometheus (сгенерирован Ansible)
# ============================================================
# Глобальные настройки

global:
  scrape_interval: 15s
  evaluation_interval: 15s

# Цели для сбора метрик
scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:{{ prometheus_port }}']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['localhost:{{ node_exporter_port }}']
